<Window x:Class="PoteryGVS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoteryGVS.Windows"
        mc:Ignorable="d"
        Title="Потери ГВС" Height="330" Width="620" Icon="/Images/icon.ico" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                    CornerRadius="7"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Width="130" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFA0A0A0"/>
        </Style>

        <Style x:Key="CircleButtonStyleSmall" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
            CornerRadius="7"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Width="100" Height="25">
                            <ContentPresenter HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFA0A0A0"/>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="/Images/screen.jpg" Stretch="UniformToFill" TileMode="Tile"/>
    </Window.Background>
    <Window.BorderBrush>
        <ImageBrush/>
    </Window.BorderBrush>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0"  HorizontalAlignment="Right">

            <Button x:Name="instructionBtn" Content="Инструкция" VerticalAlignment="Top" Width="100"
                    FontWeight="DemiBold"
                    Margin="2,2"
                    Click="instructionBtn_Click" 
                    Style="{StaticResource CircleButtonStyleSmall}" Background="#FFE3E3E3"
                    />

            <Button x:Name="settingsBtn" Content="Настройки" VerticalAlignment="Top" Width="100"
                    FontWeight="DemiBold"
                    Margin="2,2"
                    Click="settingsBtn_Click" 
                    Style="{StaticResource CircleButtonStyleSmall}" Background="#FFE3E3E3"
                    />

        </WrapPanel>

        

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="240" Width="530">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="selectOldFileBtn" Content="Потери ГВС"
                        FontWeight="DemiBold"
                        Grid.Row="0" Grid.Column="1"
                        Click="selectOldFileBtn_Click" Margin="5" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />

                <TextBlock x:Name="selectedOldFileText" Margin="0,4,0,10" TextWrapping="Wrap"
                           FontWeight="DemiBold"
                           Grid.Row="1" Grid.Column="1"
                           Text="Файл не выбран" Foreground="#FF122525" HorizontalAlignment="Center"
                           />
                
                

                <Button x:Name="selectNakladFileBtn" Content="Накладная"
                        FontWeight="DemiBold"
                        Grid.Row="2" Grid.Column="0"
                        Click="selectNakladFileBtn_Click" Margin="5" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />

                <Button x:Name="selectMPFileBtn" Content="Файл МП"
                        FontWeight="DemiBold"
                        Grid.Row="2" Grid.Column="1" 
                        Click="selectMPFileBtn_Click" Margin="5" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />

                <Button x:Name="selectODNFileBtn" Content="Файл ОДН"
                        FontWeight="DemiBold"
                        Grid.Row="2" Grid.Column="2"
                        Click="selectODNFileBtn_Click" Margin="5" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />
                
                
                <TextBlock x:Name="selectedNakladFileText" Margin="5" TextWrapping="Wrap"
                           FontWeight="DemiBold"
                           Grid.Row="3" Grid.Column="0"
                           Text="Файл не выбран" Foreground="#FF122525" HorizontalAlignment="Center"
                           />

                <TextBlock x:Name="selectedMPFileText" Margin="5" TextWrapping="Wrap"
                           FontWeight="DemiBold"
                           Grid.Row="3" Grid.Column="1"
                           Text="Файл не выбран" Foreground="#FF122525" HorizontalAlignment="Center"
                           />

                <TextBlock x:Name="selectedODNFileText" Margin="5" TextWrapping="Wrap"
                           FontWeight="DemiBold"
                           Grid.Row="3" Grid.Column="2"
                           Text="Файл не выбран" Foreground="#FF122525" HorizontalAlignment="Center"
                           />

                <TextBlock x:Name="ReadyText" Margin="0" TextWrapping="Wrap"
                           FontWeight="Bold"
                           Grid.Row="4" Grid.Column="1"
                           Text="" Foreground="#FF122525" HorizontalAlignment="Center"
                           />

                <Button x:Name="start" Content="Сформировать отчет"
                        FontWeight="DemiBold"
                        Grid.Row="5" Grid.Column="1"
                        Click="start_Click" Margin="20" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE5E5E5"
                        />
            </Grid>
            
        </StackPanel>
    </Grid>
</Window>
