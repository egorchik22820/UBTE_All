<Page x:Class="dem.Pages.BusesOutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:dem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BusesOutPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Stretch" Margin="5">
            <StackPanel Margin="5">
                <TextBlock Text="Поиск:"/>
                <TextBox x:Name="SearchBox" Width="100"/>
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Фильрация:"/>
                <ComboBox x:Name="FilterBox" Width="100"/>
            </StackPanel>

            <Button x:Name="AddBtn" Content="Добавить" Width="100" Height="20" Margin="120,15,0,0" Click="AddBtn_Click" />
            <Button x:Name="DeleteBtn" Content="Удалить" Width="100" Height="20" Margin="10,15,0,0" Click="DeleteBtn_Click"/>
            <Button x:Name="RoutesBtn" Content="Маршруты" Width="100" Height="20" Margin="10,15,0,0" Click="RoutesBtn_Click"/>
            <Button x:Name="ExitBtn" Content="Выйти" Width="100" Height="20" Margin="10,15,0,0" Click="ExitBtn_Click"/>

        </WrapPanel>

        <ListView x:Name="listBuses" Grid.Row="1" MouseDoubleClick="listBuses_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Image Source="/Images/images (1).jpg" Grid.Column="0" Width="80" Height="80" Margin="10"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock>
                                <Run Text="Гос. номер: "/>
                                <Run Text="{Binding BusNumber}"/>
                                <Run Text=" "/>
                                
                            </TextBlock>
                            
                            <TextBlock>
                                <Run Text="Марка и модель: "/>
                                <Run Text="{Binding Brand}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Model}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Year}"/>
                                <Run Text=" "/>
                            </TextBlock>

                            <TextBlock >
                                <Run Text="Тип: "/>
                                <Run Text="{Binding BusTypes.TypeName}"/>
                                <Run Text=" "/>
                                
                               
                            </TextBlock>

                            <TextBlock>
                                 <Run Text="Описание: "/>
                                 <Run Text="{Binding BusTypes.Description}"/>
                                 <Run Text=" "/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Места: "/>
                                <Run Text="{Binding BusTypes.SeatCapacity}"/>
                                <Run Text=" "/>
                            </TextBlock>

                            <TextBlock >
                                <Run Text="Статус: "/>
                                <Run Text="{Binding Status}"/>
                                <Run Text=" "/>
                            </TextBlock>
                        </StackPanel>


                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
    </Grid>
</Page>
