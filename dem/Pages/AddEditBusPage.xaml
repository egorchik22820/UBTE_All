<Page x:Class="dem.Pages.AddEditBusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:dem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBusPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="150">
            <TextBlock Text="Номер:"/>
            <TextBox x:Name="NumberBox" Margin="0,0,0,5"/>

            <TextBlock Text="Тип:"/>
            <ComboBox x:Name="ComboType" DisplayMemberPath="TypeName"/>

            <Button x:Name="SaveBtn" Content="Сохранить" Margin="10,10,10,0" Click="SaveBtn_Click"/>
            <Button x:Name="BackBtn" Content="Назад" Margin="10" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
