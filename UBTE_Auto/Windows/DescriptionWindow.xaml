<Window x:Class="UBTE_Auto.Windows.DescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UBTE_Auto.Windows"
        mc:Ignorable="d"
        Title="Описание программы" Height="500" Width="500" Icon="/AppData/Images/icon.ico"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: название и версия -->
        <Border Grid.Row="0" Background="#FFF7F7F7" BorderBrush="#E0E0E0" BorderThickness="2"
                CornerRadius="6" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="NameBlock" FontSize="22" FontWeight="Bold"
                           Foreground="#FF222222" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Версия:" FontWeight="SemiBold" Foreground="#FF666666"/>
                    <TextBlock x:Name="VersionBlock" Margin="6,0,0,0" Foreground="#FF666666"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Заголовок раздела -->
        <TextBlock Grid.Row="1" Text="Описание" FontWeight="Bold" Foreground="#FF333333"
                   Margin="2,16,0,6"/>

        <!-- Описание: прокрутка и перенос строк -->
        <Border Grid.Row="2" Background="#FFFCFCFC" BorderBrush="#E0E0E0" BorderThickness="2"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <TextBlock x:Name="DescriptionBlock" TextWrapping="Wrap" Foreground="#FF333333"
                           FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
            </ScrollViewer>
        </Border>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="3" Content="Закрыть" HorizontalAlignment="Right" Margin="0,16,0,0"
                FontWeight="DemiBold" Background="#FFE3E3E3"
                Style="{StaticResource CircleButtonStyleSmall}" Click="CloseBtn_Click"/>
    </Grid>
</Window>
