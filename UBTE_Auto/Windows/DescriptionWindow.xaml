<Window x:Class="UBTE_Auto.Windows.DescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UBTE_Auto.Windows"
        mc:Ignorable="d"
        Title="Описание" Height="500" Width="500" Icon="/AppData/Images/icon.ico" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>

        <StackPanel>
            <TextBlock x:Name="NameBlock"/>
            <TextBlock x:Name="VersionBlock"/>
            <TextBlock x:Name="DescriptionBlock"/>
        </StackPanel>
        
    </Grid>
</Window>
