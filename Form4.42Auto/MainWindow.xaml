<Window x:Class="Form4._42Auto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Form4._42Auto"
        mc:Ignorable="d"
        Title="Форма 4.42" Height="305" Width="455" Icon="/free-icon-app-development-7491568.ico" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        CornerRadius="7"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Width="130" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFA0A0A0"/>
        </Style>
    </Window.Resources>
    <Window.BorderBrush>
        <ImageBrush/>
    </Window.BorderBrush>
    <Window.Background>
        <ImageBrush ImageSource="/Img/Снимок экрана 2025-09-25 090442.png" Stretch="Fill" TileMode="Tile"/>
    </Window.Background>


    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="150" Width="400">
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="selectFileBtn" Content="Предыдущий квртал" 
                        Click="SelectOldFileBtn_Click" Margin="10" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />

                <Button x:Name="selectOldQuartBtn" Content="Выбрать ОФ ТЭ" 
                        Click="SelectFileBtn_Click" Margin="10" 
                        Style="{StaticResource CircleButtonStyle}" Background="#FFE3E3E3"
                        />
            </WrapPanel>


            <TextBlock x:Name="selectedFileText" Margin="10" TextWrapping="Wrap"
                        Text="Файл не выбран" Foreground="DarkSlateGray" HorizontalAlignment="Center"
                       />

            <Button x:Name="start" Content="Сформировать отчет" 
                    Click="start_Click" Margin="10" 
                    Style="{StaticResource CircleButtonStyle}" Background="#FFE5E5E5"
                    />
        </StackPanel>
    </Grid>
</Window>
